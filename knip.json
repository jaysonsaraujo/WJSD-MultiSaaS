{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "src/app/**/*.{ts,tsx}",
    "tooling/agent-hooks/*.ts",
    "tooling/*.ts",
    "integracoes/coderabbit/cr-comments.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "src/**/*.css", "tooling/**/*.ts", "test/**/*.ts", "*.{ts,mjs}"],
